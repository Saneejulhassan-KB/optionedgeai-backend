# =============================================================================
# Environment template for OptionEdgeAI Backend
# =============================================================================
# HOW TO USE:
#   1. Copy this file to .env   →   copy .env.example .env
#   2. Fill in real values in .env (never commit .env)
#   3. The app reads these via python-dotenv / pydantic-settings
#
# WHY THIS FILE EXISTS:
#   Safe to commit. Shows every variable the backend needs without secrets.
# =============================================================================

# Application
APP_NAME=OptionEdgeAI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0

# CORS — browser / Flutter web origins allowed to call this API
# Comma-separated exact origins (no wildcards like localhost:* — browsers reject them).
# Use * alone for early local testing only (not with cookies/credentials).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Database — SQLite for local development (no server needed)
# Later we switch to PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/optionedge
DATABASE_URL=sqlite:///./optionedge.db

# JWT — used later to issue session tokens to Flutter
# Generate a long random string (32+ characters). Never reuse across projects.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Upstox OAuth (fill these from the Upstox Developer Console)
# Flutter NEVER sees these values.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Android emulator: use 10.0.2.2 (emulator's alias for your PC).
# Windows desktop Chrome: use 127.0.0.1 instead.
# Must match Upstox Developer Console Redirect URI exactly.
UPSTOX_REDIRECT_URI=http://10.0.2.2:8010/auth/callback
UPSTOX_BASE_URL=https://api.upstox.com
UPSTOX_AUTH_URL=https://api.upstox.com/v2/login/authorization/dialog

# Optional Redis (Phase 6+ — caching / pub-sub for WebSocket fan-out)
REDIS_URL=redis://localhost:6379/0

# Historical market-data foundation (/api/v1/market/*)
HISTORICAL_SYNC_ENABLED=true
HISTORICAL_MAX_RETRIES=3
# Canonical timeframes: 1m,3m,5m,15m,30m,1h,1D
HISTORICAL_TIMEFRAMES=3m,5m,15m,1D
HISTORICAL_INSTRUMENTS=NSE_INDEX|Nifty 50,NSE_INDEX|Nifty Bank,BSE_INDEX|SENSEX
# Active window must be large enough to warm EMA200 (200 * INDICATOR_WARMUP_MULTIPLIER).
ACTIVE_CANDLE_LOOKBACK=600
DATA_STALE_THRESHOLD_SECONDS=120

# Candle lifecycle + readiness
# Timeframes updated from live WebSocket ticks
LIVE_TIMEFRAMES=3m,5m,15m
# Timeframes re-requested from Upstox after a WebSocket reconnect
RECONNECT_BACKFILL_TIMEFRAMES=3m,5m,15m
# Timeframes that must all be ready before can_trade can be true
TRADING_TIMEFRAMES=3m,5m,15m
PRIMARY_TIMEFRAME=5m
# Bars required per indicator period before it reports READY (not just a value)
INDICATOR_WARMUP_MULTIPLIER=2.0
# Recent window scanned for suspicious intraday candle gaps
COVERAGE_GAP_SCAN_DAYS=30
# Minimum seconds between forming-candle writes per instrument
LIVE_CANDLE_PERSIST_INTERVAL_SECONDS=2.0
